{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InstantActionsRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actions"
  ],
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actionType",
          "actionId",
          "blockingType"
        ],
        "properties": {
          "actionType": {
            "type": "string",
            "minLength": 1
          },
          "actionId": {
            "type": "string",
            "minLength": 1
          },
          "actionDescription": {
            "type": [
              "string",
              "null"
            ]
          },
          "blockingType": {
            "type": "string",
            "enum": [
              "NONE",
              "SOFT",
              "HARD"
            ]
          },
          "actionParameters": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
